{
  "manifest_version": 3,
  "name": "PROOFPIX SENTINEL",
  "version": "0.1.0",
  "description": "Opt-in, explainable link-checking prototype using a local API.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:8000/*"
  ],
  "action": {
    "default_title": "Check links on this tab",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  }
}
